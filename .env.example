# ========== 必填 ==========
JWT_SECRET=your-jwt-secret-at-least-32-chars-long
DATABASE_URL=postgresql://user:password@localhost:5432/travel_db

# ========== LLM 提供商（至少配置一个） ==========
SILICONFLOW_API_KEY=your-siliconflow-api-key
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct
DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# ========== Sentry 错误监控（可选） ==========
# 在 https://sentry.io 创建项目后获取 DSN
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ========== 图片服务 API（可选） ==========
# Unsplash API - 免费额度50次/小时
# 注册地址：https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
# Pexels API - 免费额度200次/小时
# 注册地址：https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-api-key

# ========== 高德地图 API（可选） ==========
# 城市搜索服务，免费额度30万次/天
# 注册地址：https://lbs.amap.com/dev/key/app
# AMAP_API_KEY=your-amap-api-key

# ========== 可选 ==========
# NODE_ENV=development
# ADMIN_USERS=admin1,admin2
# IMAGE_BASE_URL=https://your-cdn.com
# LLM_TIMEOUT_MS=60000
# LLM_STREAM_TIMEOUT_MS=120000
